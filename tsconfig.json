{
  "extends": "@sgiant/tsconfig/base.json",
  "compilerOptions": {
    // Source-only browser package (main/exports → src, like @sgiant/ui and
    // @sgiant/assets): consumers are bundlers, so no dist is emitted. Bundler
    // resolution + JSX because this package now imports @sgiant/assets' raw
    // .tsx sources (the shared apply-proposal helpers), which use
    // extensionless imports that NodeNext refuses.
    // An unused import here is a CONSUMER's error without these, because the
    // shared base sets `strict` but not these two, and only the SPAs turn them
    // on. This package ships SOURCE, so `tsc --noEmit` here never saw the
    // orphaned imports two #320 extractions left behind — both surfaced in
    // apps/ui-org and apps/marketing instead, which is the wrong package, the
    // wrong person, and one CI round trip later.
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "incremental": false
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
